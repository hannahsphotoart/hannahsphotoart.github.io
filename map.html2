<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nicht aus dem Münsterland? | Hannahs Photoart</title>
  <meta name="description" content="Du bist nicht aus dem Kreis Borken oder Coesfeld? Trag dich ein – ich plane Shootings und Touren dorthin, wo sich Interesse sammelt." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #f7f3ee;
      --warm-white: #faf8f5;
      --sand: #e8ddd0;
      --mocha: #8b6f5a;
      --espresso: #3d2b1f;
      --gold: #c4975a;
      --gold-light: #dbb882;
      --text: #2a1f18;
      --text-muted: #7a6558;
      --border: rgba(139,111,90,0.2);
      --border-strong: rgba(139,111,90,0.4);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Jost', sans-serif;
      font-weight: 300;
      background: var(--cream);
      color: var(--text);
      min-height: 100vh;
    }

    /* ── HERO ── */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4rem 2rem 6rem;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 50% at 50% 0%, rgba(196,151,90,0.12) 0%, transparent 70%),
        radial-gradient(ellipse 40% 60% at 80% 100%, rgba(139,111,90,0.08) 0%, transparent 60%);
      pointer-events: none;
    }

    .back-link {
      position: absolute;
      top: 2rem;
      left: 2rem;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s;
    }
    .back-link:hover { color: var(--gold); }
    .back-link svg { width: 14px; height: 14px; }

    .hero-eyebrow {
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1.5rem;
    }

    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 300;
      font-size: clamp(2.4rem, 6vw, 4.2rem);
      line-height: 1.15;
      color: var(--espresso);
      margin-bottom: 1.5rem;
      max-width: 720px;
    }

    .hero-title em {
      font-style: italic;
      color: var(--gold);
    }

    .hero-sub {
      font-size: 15px;
      font-weight: 300;
      color: var(--text-muted);
      max-width: 480px;
      line-height: 1.8;
      margin-bottom: 2.5rem;
    }

    .scroll-hint {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      color: var(--text-muted);
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      animation: float 2.5s ease-in-out infinite;
    }
    .scroll-hint svg { width: 18px; height: 18px; opacity: 0.5; }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(6px); }
    }

    /* ── DIVIDER ── */
    .divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0 2rem;
      max-width: 900px;
      margin: 0 auto;
    }
    .divider-line { flex: 1; height: 0.5px; background: var(--border-strong); }
    .divider-text { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--mocha); white-space: nowrap; }

    /* ── MAP SECTION ── */
    .map-section {
      padding: 5rem 2rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .section-label {
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.75rem;
      text-align: center;
    }

    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 300;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      color: var(--espresso);
      text-align: center;
      margin-bottom: 0.75rem;
    }

    .section-sub {
      font-size: 14px;
      color: var(--text-muted);
      text-align: center;
      margin-bottom: 3rem;
      line-height: 1.8;
    }

    .map-container {
      position: relative;
      background: var(--warm-white);
      border: 0.5px solid var(--border-strong);
      border-radius: 16px;
      overflow: hidden;
      cursor: crosshair;
    }

    .map-container:hover { border-color: var(--gold-light); }

    .map-hint-bar {
      text-align: center;
      padding: 10px;
      font-size: 12px;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      border-top: 0.5px solid var(--border);
    }

    #dachSvg { width: 100%; display: block; }

    /* ── MODAL ── */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(42,31,24,0.65);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      backdrop-filter: blur(3px);
    }
    .modal-overlay.open { display: flex; }

    .modal {
      background: var(--warm-white);
      border-radius: 16px;
      border: 0.5px solid var(--border-strong);
      padding: 2rem;
      width: 100%;
      max-width: 460px;
      position: relative;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--text-muted);
      font-size: 20px;
      line-height: 1;
      padding: 4px;
      transition: color 0.2s;
    }
    .modal-close:hover { color: var(--espresso); }

    .modal-eyebrow {
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.5rem;
    }

    .modal-title {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 300;
      font-size: 1.6rem;
      color: var(--espresso);
      margin-bottom: 0.25rem;
    }

    .modal-loc {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 0.5px solid var(--border);
    }

    .field { margin-bottom: 1rem; }
    .field label {
      display: block;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--mocha);
      margin-bottom: 6px;
    }
    .field input,
    .field select,
    .field textarea {
      width: 100%;
      background: var(--cream);
      border: 0.5px solid var(--border-strong);
      border-radius: 8px;
      padding: 10px 14px;
      font-family: 'Jost', sans-serif;
      font-size: 14px;
      font-weight: 300;
      color: var(--text);
      outline: none;
      transition: border-color 0.2s;
      appearance: none;
    }
    .field input:focus,
    .field select:focus,
    .field textarea:focus { border-color: var(--gold); }
    .field textarea { resize: vertical; min-height: 80px; }

    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    .submit-btn {
      width: 100%;
      margin-top: 1.25rem;
      padding: 13px;
      background: var(--espresso);
      color: var(--cream);
      border: none;
      border-radius: 8px;
      font-family: 'Jost', sans-serif;
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }
    .submit-btn:hover { background: var(--gold); }
    .submit-btn:active { transform: scale(0.99); }

    /* ── SUCCESS ── */
    .success-screen {
      display: none;
      text-align: center;
      padding: 2rem 1rem;
    }
    .success-screen.show { display: block; }
    .success-icon { font-size: 2.5rem; margin-bottom: 1rem; }
    .success-screen h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.8rem;
      font-weight: 300;
      color: var(--espresso);
      margin-bottom: 0.5rem;
    }
    .success-screen p { font-size: 14px; color: var(--text-muted); line-height: 1.7; }

    /* ── CLUSTERS ── */
    .clusters-section {
      padding: 3rem 2rem 5rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .clusters-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 10px;
      margin-top: 2rem;
    }

    .cluster-card {
      background: var(--warm-white);
      border: 0.5px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      text-align: center;
    }
    .cluster-count {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 300;
      color: var(--gold);
      line-height: 1;
      margin-bottom: 4px;
    }
    .cluster-city { font-size: 13px; color: var(--text-muted); }

    /* ── ADMIN ── */
    .admin-toggle-wrap { text-align: center; padding: 1rem 0 3rem; }
    .admin-toggle-btn {
      background: none;
      border: 0.5px solid var(--border-strong);
      border-radius: 6px;
      padding: 6px 14px;
      font-family: 'Jost', sans-serif;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }
    .admin-toggle-btn:hover { color: var(--espresso); border-color: var(--mocha); }

    .admin-panel {
      display: none;
      max-width: 700px;
      margin: 0 auto;
      padding: 0 2rem 4rem;
    }
    .admin-panel.open { display: block; }

    .admin-login {
      display: flex;
      gap: 10px;
      margin-bottom: 1.5rem;
      align-items: center;
    }
    .admin-login input {
      flex: 1;
      background: var(--warm-white);
      border: 0.5px solid var(--border-strong);
      border-radius: 8px;
      padding: 9px 14px;
      font-family: 'Jost', sans-serif;
      font-size: 14px;
      color: var(--text);
      outline: none;
    }
    .admin-login input:focus { border-color: var(--gold); }
    .admin-login button {
      padding: 9px 18px;
      background: var(--espresso);
      color: var(--cream);
      border: none;
      border-radius: 8px;
      font-family: 'Jost', sans-serif;
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .entry-card {
      background: var(--warm-white);
      border: 0.5px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin-bottom: 10px;
    }
    .entry-name { font-size: 15px; font-weight: 400; color: var(--espresso); margin-bottom: 3px; }
    .entry-meta { font-size: 12px; color: var(--text-muted); margin-bottom: 6px; display: flex; flex-wrap: wrap; gap: 12px; }
    .entry-msg { font-size: 13px; color: var(--text); border-top: 0.5px solid var(--border); padding-top: 8px; margin-top: 8px; line-height: 1.6; }
    .tour-badge {
      display: inline-block;
      background: rgba(196,151,90,0.15);
      color: var(--gold);
      border: 0.5px solid rgba(196,151,90,0.4);
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 20px;
      margin-bottom: 1rem;
    }
    .admin-summary {
      background: rgba(196,151,90,0.08);
      border: 0.5px solid rgba(196,151,90,0.3);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.5rem;
      font-size: 14px;
      color: var(--espresso);
      line-height: 1.7;
    }

    /* ── FOOTER ── */
    footer {
      text-align: center;
      padding: 2rem;
      font-size: 12px;
      color: var(--text-muted);
      border-top: 0.5px solid var(--border);
      letter-spacing: 0.05em;
    }
    footer a { color: var(--gold); text-decoration: none; }

    /* ── PINS ── */
    .map-pin { cursor: default; }
    .map-pin-dot { transition: r 0.2s; }

    @media (max-width: 600px) {
      .field-row { grid-template-columns: 1fr; }
      .hero { padding: 5rem 1.5rem 4rem; }
    }
  </style>
</head>
<body>

<!-- HERO -->
<section class="hero">
  <a href="https://www.hannahs-photoart.com/" class="back-link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
    Zurück
  </a>

  <p class="hero-eyebrow">Hannahs Photoart · Deutschlandweit</p>

  <h1 class="hero-title">
    Du bist nicht aus dem<br />
    <em>Münsterland?</em>
  </h1>

  <p class="hero-sub">
    Ich bin in Ahaus zu Hause — aber meine Kamera reist gerne mit.<br />
    Setz deinen Pin auf die Karte. Wenn sich an einem Ort genug Interesse sammelt, 
    plane ich eine Tour dorthin.
  </p>

  <div class="scroll-hint">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    Zur Karte scrollen
  </div>
</section>

<div class="divider">
  <div class="divider-line"></div>
  <div class="divider-text">Dein Ort auf der Karte</div>
  <div class="divider-line"></div>
</div>

<!-- MAP -->
<section class="map-section">
  <p class="section-label">DACH · Deutschland · Österreich · Schweiz</p>
  <h2 class="section-title">Wo bist du?</h2>
  <p class="section-sub">Klick auf deinen Ort — ein kurzes Formular öffnet sich.<br />Deine E-Mail sehe nur ich.</p>

  <div class="map-container" id="mapContainer">
    <svg id="dachSvg" viewBox="0 0 800 740" xmlns="http://www.w3.org/2000/svg"></svg>
    <div class="map-hint-bar">Klick auf die Karte um deinen Pin zu setzen</div>
  </div>
</section>

<!-- CLUSTERS (public) -->
<div class="divider"><div class="divider-line"></div><div class="divider-text">Bisherige Pins</div><div class="divider-line"></div></div>
<section class="clusters-section">
  <p class="section-label">Interesse nach Region</p>
  <h2 class="section-title">Wo sammelt sich was?</h2>
  <p class="section-sub">Anonym — nur Städtenamen, keine persönlichen Daten.</p>
  <div class="clusters-grid" id="clustersGrid">
    <div style="text-align:center;color:var(--text-muted);font-size:14px;grid-column:1/-1;padding:2rem 0;">Noch keine Pins — sei die erste! 🌟</div>
  </div>
</section>

<!-- ADMIN TOGGLE -->
<div class="admin-toggle-wrap">
  <button class="admin-toggle-btn" onclick="document.getElementById('adminPanel').classList.toggle('open')">Admin ⚙</button>
</div>

<div class="admin-panel" id="adminPanel">
  <p class="section-label" style="text-align:center;margin-bottom:1rem;">Nur für Hannah</p>
  <div class="admin-login">
    <input type="password" id="adminPw" placeholder="Passwort" />
    <button onclick="loadAdmin()">Laden</button>
  </div>
  <div id="adminContent"></div>
</div>

<!-- FOOTER -->
<footer>
  <p>© Hannahs Photoart · <a href="https://www.hannahs-photoart.com/">Zurück zur Startseite</a></p>
  <p style="margin-top:6px;">Deine Daten werden nur zur Tourenplanung genutzt und nicht weitergegeben.</p>
</footer>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <button class="modal-close" onclick="closeModal()">✕</button>

    <div id="formView">
      <p class="modal-eyebrow">Pin setzen</p>
      <h2 class="modal-title">Deine Anfrage</h2>
      <p class="modal-loc" id="modalLoc">Region wird ermittelt…</p>

      <form id="pinForm" onsubmit="submitPin(event)">
        <div class="field-row">
          <div class="field">
            <label>Dein Name *</label>
            <input type="text" id="fName" placeholder="Lena M." required />
          </div>
          <div class="field">
            <label>E-Mail *</label>
            <input type="email" id="fEmail" placeholder="deine@mail.de" required />
          </div>
        </div>

        <div class="field">
          <label>Deine Stadt / Region *</label>
          <input type="text" id="fCity" placeholder="z.B. Hamburg, München, Wien…" required />
        </div>

        <div class="field">
          <label>Art des Shootings</label>
          <select id="fType">
            <option value="">Was schwebt dir vor?</option>
            <option>Couple Shooting</option>
            <option>Portrait Shooting</option>
            <option>Elopement / freie Trauung</option>
            <option>Babybauch</option>
            <option>Familien Shooting</option>
            <option>Sonstiges</option>
          </select>
        </div>

        <div class="field">
          <label>Nachricht (optional)</label>
          <textarea id="fMsg" placeholder="Was hast du dir vorgestellt? Gibt es einen besonderen Ort, eine Stimmung, eine Idee…"></textarea>
        </div>

        <button type="submit" class="submit-btn">Pin setzen &amp; Anfrage senden</button>
        <p style="font-size:11px;color:var(--text-muted);text-align:center;margin-top:10px;line-height:1.6;">Deine E-Mail sieht nur Hannah · Auf der Karte erscheint nur deine Stadt</p>
      </form>
    </div>

    <div class="success-screen" id="successView">
      <div class="success-icon">🌿</div>
      <h3>Danke, dein Pin ist gesetzt.</h3>
      <p>Ich melde mich, sobald sich in deiner Region genug Interesse gesammelt hat — oder früher, wenn wir einfach einen Termin finden. 💛</p>
      <button onclick="closeModal()" class="submit-btn" style="margin-top:1.5rem;">Schließen</button>
    </div>
  </div>
</div>

<script>
const STORAGE_KEY = 'hannah_photoart_pins_v3';
const ADMIN_PW = 'hannahs2025';

/* ── DACH MAP PATHS (simplified but recognizable outlines) ── */
const GERMANY = `M 312 48 C 318 42 328 38 340 36 C 355 34 372 36 385 42 C 398 48 408 58 415 70 C 422 82 424 96 420 110 C 416 124 406 136 400 148 C 394 160 392 172 394 184 C 396 196 402 206 404 218 C 406 230 404 242 398 252 C 392 262 382 270 376 280 C 370 290 368 302 364 314 C 360 326 354 338 344 346 C 334 354 320 358 308 362 C 296 366 284 368 272 372 C 260 376 248 382 238 390 C 228 398 220 408 212 418 C 204 428 196 438 186 444 C 176 450 164 452 154 456 C 144 460 136 466 126 468 C 116 470 104 468 96 462 C 88 456 84 446 82 436 C 80 426 82 416 84 406 C 86 396 90 386 90 376 C 90 366 86 356 82 346 C 78 336 72 326 70 316 C 68 306 70 296 74 286 C 78 276 84 268 88 258 C 92 248 94 238 94 228 C 94 218 90 208 88 198 C 86 188 86 178 88 168 C 90 158 94 148 96 138 C 98 128 98 118 100 108 C 102 98 106 88 112 80 C 118 72 126 66 134 62 C 142 58 152 56 162 54 C 172 52 182 52 192 52 C 202 52 212 54 222 54 C 232 54 242 52 252 50 C 262 48 272 44 282 44 C 292 44 302 46 312 48 Z`;

const AUSTRIA = `M 188 506 C 196 500 208 496 222 494 C 236 492 252 492 268 492 C 284 492 300 494 316 494 C 332 494 348 492 362 494 C 376 496 388 502 398 510 C 408 518 414 530 416 542 C 418 554 414 566 408 576 C 402 586 392 594 382 598 C 372 602 360 602 348 602 C 336 602 324 600 312 600 C 300 600 288 602 276 600 C 264 598 252 592 242 586 C 232 580 224 572 216 564 C 208 556 200 546 194 536 C 188 526 184 516 184 506 C 184 500 186 502 188 506 Z`;

const SWITZERLAND = `M 148 486 C 156 476 168 468 182 464 C 196 460 212 460 226 464 C 240 468 252 476 262 486 C 272 496 278 510 278 524 C 278 538 272 552 262 562 C 252 572 238 578 224 580 C 210 582 196 578 184 572 C 172 566 162 556 156 544 C 150 532 146 518 146 504 C 146 498 147 492 148 486 Z`;

/* ── CITY COORDINATES (% of viewBox 800x740) ── */
const CITIES = {
  'Hamburg': [310, 92], 'Berlin': [440, 130], 'München': [360, 390],
  'Köln': [198, 210], 'Frankfurt': [258, 258], 'Stuttgart': [248, 338],
  'Düsseldorf': [188, 206], 'Leipzig': [380, 194], 'Dortmund': [210, 196],
  'Essen': [196, 196], 'Bremen': [278, 100], 'Dresden': [420, 200],
  'Hannover': [316, 128], 'Nürnberg': [340, 310], 'Duisburg': [188, 200],
  'Wien': [440, 522], 'Graz': [410, 550], 'Innsbruck': [330, 548],
  'Zürich': [218, 506], 'Basel': [196, 490], 'Bern': [190, 530],
  'Ahaus': [168, 174]
};

let pendingXY = null;
let allPins = [];

function initMap() {
  const svg = document.getElementById('dachSvg');

  /* country fills */
  const countries = [
    { d: GERMANY, label: 'Deutschland', lx: 240, ly: 260 },
    { d: AUSTRIA, label: 'Österreich', lx: 300, ly: 542 },
    { d: SWITZERLAND, label: 'Schweiz', lx: 196, ly: 524 },
  ];

  countries.forEach(c => {
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', c.d);
    path.setAttribute('fill', '#faf8f5');
    path.setAttribute('stroke', '#c4975a');
    path.setAttribute('stroke-width', '1');
    path.setAttribute('stroke-linejoin', 'round');
    svg.appendChild(path);

    const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    label.setAttribute('x', c.lx);
    label.setAttribute('y', c.ly);
    label.setAttribute('text-anchor', 'middle');
    label.setAttribute('font-size', '11');
    label.setAttribute('fill', '#c4975a');
    label.setAttribute('font-family', 'Jost, sans-serif');
    label.setAttribute('letter-spacing', '2');
    label.setAttribute('font-weight', '300');
    label.textContent = c.label.toUpperCase();
    svg.appendChild(label);
  });

  /* Ahaus home marker */
  const [hx, hy] = CITIES['Ahaus'];
  const homeCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  homeCircle.setAttribute('cx', hx); homeCircle.setAttribute('cy', hy);
  homeCircle.setAttribute('r', '5');
  homeCircle.setAttribute('fill', '#c4975a');
  svg.appendChild(homeCircle);
  const homeLabel = document.createElementNS('http://www.w3.org/2000/svg', 'text');
  homeLabel.setAttribute('x', hx + 8); homeLabel.setAttribute('y', hy + 4);
  homeLabel.setAttribute('font-size', '10'); homeLabel.setAttribute('fill', '#8b6f5a');
  homeLabel.setAttribute('font-family', 'Jost, sans-serif');
  homeLabel.textContent = '🏠 Ahaus';
  svg.appendChild(homeLabel);

  /* subtle city dots */
  Object.entries(CITIES).forEach(([name, [cx, cy]]) => {
    if (name === 'Ahaus') return;
    const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    dot.setAttribute('cx', cx); dot.setAttribute('cy', cy);
    dot.setAttribute('r', '2');
    dot.setAttribute('fill', '#e8ddd0');
    svg.appendChild(dot);
    const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    t.setAttribute('x', cx + 5); t.setAttribute('y', cy + 4);
    t.setAttribute('font-size', '8'); t.setAttribute('fill', '#b8a898');
    t.setAttribute('font-family', 'Jost, sans-serif');
    t.textContent = name;
    svg.appendChild(t);
  });

  /* pin group on top */
  const pinGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
  pinGroup.id = 'pinGroup';
  svg.appendChild(pinGroup);

  /* click handler */
  document.getElementById('mapContainer').addEventListener('click', e => {
    const rect = svg.getBoundingClientRect();
    const x = Math.round(((e.clientX - rect.left) / rect.width) * 800);
    const y = Math.round(((e.clientY - rect.top) / rect.height) * 740);
    pendingXY = { x, y };
    const region = guessRegion(x, y);
    document.getElementById('modalLoc').textContent = '📍 ' + region;
    document.getElementById('fCity').value = '';
    document.getElementById('modalOverlay').classList.add('open');
    document.getElementById('formView').style.display = 'block';
    document.getElementById('successView').classList.remove('show');
  });

  loadAndRenderPins();
}

function guessRegion(x, y) {
  /* rough DACH region guess from coordinates */
  if (y < 130) {
    if (x < 250) return 'Nordseeküste / Schleswig-Holstein';
    if (x < 380) return 'Hamburg / Bremen Umgebung';
    return 'Mecklenburg-Vorpommern';
  }
  if (y < 210) {
    if (x < 220) return 'NRW / Ruhrgebiet';
    if (x < 310) return 'Niedersachsen';
    if (x < 420) return 'Brandenburg / Berlin';
    return 'Ostseeraum';
  }
  if (y < 290) {
    if (x < 200) return 'Rheinland';
    if (x < 280) return 'Hessen / Thüringen';
    if (x < 380) return 'Sachsen / Sachsen-Anhalt';
    return 'Ostdeutschland';
  }
  if (y < 380) {
    if (x < 220) return 'Rheinland-Pfalz / Saarland';
    if (x < 300) return 'Baden-Württemberg';
    if (x < 400) return 'Bayern';
    return 'Ostbayern';
  }
  if (y < 470) {
    if (x < 220) return 'Elsass / Grenzraum';
    if (x < 320) return 'Oberbayern / Allgäu';
    return 'Bayern Süd / Berchtesgaden';
  }
  if (y < 560) {
    if (x < 280) return 'Schweiz';
    if (x < 420) return 'Österreich / Tirol / Salzburg';
    return 'Wien / Ostösterreich';
  }
  return 'Südlicher DACH-Raum';
}

function addPinToSvg(pin) {
  const g = document.getElementById('pinGroup');
  const pg = document.createElementNS('http://www.w3.org/2000/svg', 'g');
  pg.setAttribute('class', 'map-pin');

  /* pin teardrop shape */
  const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  circle.setAttribute('cx', pin.x); circle.setAttribute('cy', pin.y - 8);
  circle.setAttribute('r', '6');
  circle.setAttribute('fill', '#c4975a');
  circle.setAttribute('class', 'map-pin-dot');

  const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
  line.setAttribute('x1', pin.x); line.setAttribute('y1', pin.y - 2);
  line.setAttribute('x2', pin.x); line.setAttribute('y2', pin.y + 4);
  line.setAttribute('stroke', '#c4975a'); line.setAttribute('stroke-width', '1.5');

  const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
  label.setAttribute('x', pin.x + 9); label.setAttribute('y', pin.y - 5);
  label.setAttribute('font-size', '9'); label.setAttribute('fill', '#3d2b1f');
  label.setAttribute('font-family', 'Jost, sans-serif');
  label.textContent = pin.city || '';

  pg.appendChild(line); pg.appendChild(circle); pg.appendChild(label);
  g.appendChild(pg);
}

async function loadAndRenderPins() {
  try {
    const r = await window.storage.get(STORAGE_KEY, true);
    if (!r) return;
    allPins = JSON.parse(r.value);
    allPins.forEach(addPinToSvg);
    renderClusters();
  } catch(e) {}
}

function renderClusters() {
  const grid = document.getElementById('clustersGrid');
  if (!allPins.length) return;
  const counts = {};
  allPins.forEach(p => {
    const c = p.city || 'Unbekannt';
    counts[c] = (counts[c] || 0) + 1;
  });
  const sorted = Object.entries(counts).sort((a,b) => b[1]-a[1]);
  grid.innerHTML = sorted.map(([city, n]) => `
    <div class="cluster-card">
      <div class="cluster-count">${n}</div>
      <div class="cluster-city">${city}</div>
    </div>
  `).join('');
}

function closeModal() {
  document.getElementById('modalOverlay').classList.remove('open');
  pendingXY = null;
}

async function submitPin(e) {
  e.preventDefault();
  const name = document.getElementById('fName').value.trim();
  const email = document.getElementById('fEmail').value.trim();
  const city = document.getElementById('fCity').value.trim();
  const type = document.getElementById('fType').value;
  const msg = document.getElementById('fMsg').value.trim();
  if (!name || !email || !city) return;

  const pin = {
    name, email, city, type, msg,
    x: pendingXY.x, y: pendingXY.y,
    ts: Date.now()
  };

  try {
    let pins = [];
    try { const r = await window.storage.get(STORAGE_KEY, true); if (r) pins = JSON.parse(r.value); } catch(_){}
    pins.push(pin);
    await window.storage.set(STORAGE_KEY, JSON.stringify(pins), true);
    allPins = pins;
  } catch(err) { console.error(err); }

  addPinToSvg(pin);
  renderClusters();

  document.getElementById('formView').style.display = 'none';
  document.getElementById('successView').classList.add('show');

  /* Reset form */
  ['fName','fEmail','fCity','fMsg'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('fType').value = '';
}

async function loadAdmin() {
  const pw = document.getElementById('adminPw').value;
  if (pw !== ADMIN_PW) { alert('Falsches Passwort.'); return; }

  const content = document.getElementById('adminContent');
  content.innerHTML = '<p style="color:var(--text-muted);font-size:14px;">Lade…</p>';

  try {
    const r = await window.storage.get(STORAGE_KEY, true);
    if (!r) { content.innerHTML = '<p style="color:var(--text-muted);font-size:14px;">Noch keine Einträge.</p>'; return; }
    const pins = JSON.parse(r.value);
    if (!pins.length) { content.innerHTML = '<p style="color:var(--text-muted);font-size:14px;">Noch keine Einträge.</p>'; return; }

    /* cluster detection */
    const counts = {};
    pins.forEach(p => { const c = p.city||'?'; counts[c]=(counts[c]||0)+1; });
    const tourSpots = Object.entries(counts).filter(([,n])=>n>=2).map(([c,n])=>`${c} (${n} Anfragen)`);

    let html = `<div class="admin-summary">
      <strong>${pins.length} Anfrage(n) gesamt</strong><br/>
      ${tourSpots.length ? '🗺️ Tour-Potenzial: ' + tourSpots.join(' · ') : 'Noch kein Tour-Cluster (mind. 2 aus einem Ort).'}
    </div>`;

    pins.slice().reverse().forEach(p => {
      const d = new Date(p.ts).toLocaleDateString('de-DE', {day:'2-digit',month:'2-digit',year:'numeric'});
      html += `<div class="entry-card">
        <div class="entry-name">${p.name}</div>
        <div class="entry-meta">
          <span>📧 ${p.email}</span>
          <span>📍 ${p.city||'–'}</span>
          <span>${p.type||'kein Typ'}</span>
          <span>${d}</span>
        </div>
        ${p.msg ? `<div class="entry-msg">${p.msg}</div>` : ''}
      </div>`;
    });
    content.innerHTML = html;
  } catch(err) {
    content.innerHTML = '<p style="color:var(--text-muted);">Fehler beim Laden.</p>';
  }
}

initMap();
</script>
</body>
</html>
